---
/**
 * Replaces Starlight's built-in <select>, which offers Auto / Light / Dark.
 * This is a plain two-state button — no "auto".
 *
 * Starlight's own ThemeProvider script still runs and reads the same
 * `starlight-theme` localStorage key, so persistence stays compatible; we just
 * never write the "auto" value.
 */
---

<button
  class="gata-theme-toggle"
  type="button"
  aria-live="polite"
  data-theme-toggle
>
  <span class="sr-only">Toggle dark mode</span>
  <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.3 6.3 4.8 4.8M19.2 19.2l-1.5-1.5M17.7 6.3l1.5-1.5M4.8 19.2l1.5-1.5"></path>
  </svg>
  <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const KEY = "starlight-theme";
    const btn = document.querySelector("[data-theme-toggle]");
    if (!btn) return;

    const current = () =>
      document.documentElement.dataset.theme === "light" ? "light" : "dark";

    const apply = (theme) => {
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem(KEY, theme);
      } catch {}
      btn.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
      btn.setAttribute("aria-pressed", String(theme === "dark"));
    };

    // A stored "auto" from a previous visit resolves once to a concrete value.
    let stored;
    try {
      stored = localStorage.getItem(KEY);
    } catch {}
    if (stored !== "light" && stored !== "dark") {
      apply(window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
    } else {
      apply(stored);
    }

    btn.addEventListener("click", () => apply(current() === "dark" ? "light" : "dark"));
  })();
</script>
